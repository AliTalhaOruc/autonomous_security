<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="fire_station">
    <static>true</static>
    <link name="link">
      <collision name="main">
        <pose>0 -0.05 2 0 0 0</pose>
        <geometry>
          <box>
            <size>8 3.8 4</size> <!-- Çarpışma kutusunu da orantılı küçülttük -->
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <scale>0.4 0.4 0.4</scale> <!-- Modele ölçek eklendi -->
            <uri>model://fire_station/meshes/fire_station.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
