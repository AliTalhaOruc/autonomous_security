<?xml version='1.0'?>
<sdf version='1.5'>
  <model name='mili_map'>

    <!-- ======================================================= -->
    <!--  1. BOYLU BOYUNCA GEÇİRMESİZ DIŞ SINIR DUVARLARI         -->
    <!--     (Lidar Kaçırmaması İçin İçeri Çekildi ve Görünür Yapıldı) -->
    <!-- ======================================================= -->

    <!-- BATI DUVARI (X = -20 konumuna çekildi, uzunluk 40m yapıldı) -->
    <link name='west_boundary_wall'>
      <pose>-20 0 1.5 0 0 0</pose>
      <collision name='collision'>
        <geometry>
          <box>
            <size>0.5 40.0 3.0</size> 
          </box>
        </geometry>
      </collision>
      <visual name='visual'>
        <!-- GEÇİCİ OLARAK GÖRÜNÜR YAPILDI (transparency 0 yapıldı veya kaldırıldı) -->
        <transparency>0</transparency> 
        <geometry>
          <box>
            <size>0.5 40.0 3.0</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Red</name> <!-- Konumunu rahat görmeniz için kırmızı yapıldı -->
          </script>
        </material>
      </visual>
    </link>

    <!-- DOĞU DUVARI (X = 19 konumuna çekildi, fire_station'a tam yaslandı) -->
    <link name='east_boundary_wall'>
      <pose>19 0 1.5 0 0 0</pose>
      <collision name='collision'>
        <geometry>
          <box>
            <size>0.5 40.0 3.0</size>
          </box>
        </geometry>
      </collision>
      <visual name='visual'>
        <transparency>0</transparency> 
        <geometry>
          <box>
            <size>0.5 40.0 3.0</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Red</name>
          </script>
        </material>
      </visual>
    </link>

    <!-- GÜNEY DUVARI (Y = -20 konumuna çekildi) -->
    <link name='south_boundary_wall'>
      <pose>0 -20 1.5 0 0 0</pose>
      <collision name='collision'>
        <geometry>
          <box>
            <size>40.0 0.5 3.0</size>
          </box>
        </geometry>
      </collision>
      <visual name='visual'>
        <transparency>0</transparency> 
        <geometry>
          <box>
            <size>40.0 0.5 3.0</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Red</name>
          </script>
        </material>
      </visual>
    </link>

    <!-- KUZEY DUVARI (Y = 19 konumuna çekildi, fire_station arkasını sıfırladı) -->
    <link name='north_boundary_wall'>
      <pose>0 20 1.5 0 0 0</pose>
      <collision name='collision'>
        <geometry>
          <box>
            <size>40.0 0.5 3.0</size>
          </box>
        </geometry>
      </collision>
      <visual name='visual'>
        <transparency>0</transparency> 
        <geometry>
          <box>
            <size>40.0 0.5 3.0</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Red</name>
          </script>
        </material>
      </visual>
    </link>

    <!-- ======================================================= -->
    <!-- 2. İÇ DUVARLAR (Değişmedi)                              -->
    <!-- ======================================================= -->
    <include>
      <static>true</static>
      <name>digital_wall_1</name>
      <pose>-12 -8 0 0 0 1.5708</pose> 
      <uri>model://digital_wall</uri>
    </include>

    <include>
      <static>true</static>
      <name>digital_wall_2</name>
      <pose>-6 2 0 0 0 1.5708</pose> 
      <uri>model://digital_wall</uri>
    </include>

    <include>
      <static>true</static>
      <name>digital_wall_3</name>
      <pose>-12 8 0 0 0 1.5708</pose> 
      <uri>model://digital_wall</uri>
    </include>

    <!-- ======================================================= -->
    <!-- 3. BİNALAR (Değişmedi - Doğu ve Kuzey Duvarı Buraya Yaslandı) -->
    <!-- ======================================================= -->
    <include>
      <name>house_1</name>
      <static>true</static>
      <pose>15 -15 0 0 0 0</pose> 
      <uri>model://house_1</uri>
    </include>

    <include>
      <name>fire_station_1</name>
      <static>true</static>
      <pose>15 15 0 0 0 0</pose> 
      <uri>model://fire_station</uri>
    </include>

    <!-- ======================================================= -->
    <!-- 4. TANKLAR (Değişmedi)                                   -->
    <!-- ======================================================= -->
    <include>
      <name>tank1_1</name>
      <static>true</static>
      <pose>6 -16 0 0 0 3.14159</pose>
      <uri>model://tank1</uri>
    </include>

    <include>
      <name>tank1_2</name>
      <static>true</static>
      <pose>6 -10 0 0 0 3.14159</pose>
      <uri>model://tank1</uri>
    </include>

    <include>
      <name>tank2_1</name>
      <static>true</static>
      <pose>6 10 0 0 0 3.14159</pose>
      <uri>model://tank2</uri>
    </include>

    <include>
      <name>tank2_2</name>
      <static>true</static>
      <pose>6 16 0 0 0 3.14159</pose>
      <uri>model://tank2</uri>
    </include>

    <!-- ======================================================= -->
    <!-- 5. ORTA ALAN: ASKERLER VE UYARI LEVHASI                 -->
    <!-- ======================================================= -->
    <include>
      <name>stop_sign_1</name>
      <static>true</static>
      <pose>8 0 0 0 0 -1.5708</pose>
      <uri>model://stop_sign</uri>
    </include>

    <include>
      <name>soldier_1</name>
      <static>true</static>
      <pose>12 -4 0 0 0 3.14159</pose>
      <uri>model://soldier</uri>
    </include>

    <include>
      <name>soldier_2</name>
      <static>true</static>
      <pose>12 0 0 0 0 3.14159</pose>
      <uri>model://soldier</uri>
    </include>

    <include>
      <name>soldier_3</name>
      <static>true</static>
      <pose>12 4 0 0 0 3.14159</pose>
      <uri>model://soldier</uri>
    </include>

  </model>
</sdf>
